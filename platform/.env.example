# STOV AI Scientist — runtime configuration (copy to .env; NEVER commit .env)

# DeepSeek runtime (only provider credential used by the Python runtime)
DEEPSEEK_API_KEY=

# Model routing: main = complex reasoning/hypothesis/mechanism; fast = extraction/classification
STOV_MAIN_MODEL=deepseek-v4-pro
STOV_FAST_MODEL=deepseek-v4-flash

# LangSmith tracing + deployment
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=stov-ai-scientist

STOV_ENV=development

# Artifact root (relative to platform/)
ARTIFACT_ROOT=../artifacts

# SQLite default; empty means default local sqlite file (metadata only, v1).
# Production uses a PostgreSQL-compatible URL (not used in v1).
DATABASE_URL=

LOG_LEVEL=INFO

# LLM behaviour (managed by Settings, not scattered in agent code)
STOV_LLM_TIMEOUT=180
STOV_LLM_MAX_RETRIES=2
STOV_LLM_TEMPERATURE=0.0
STOV_LLM_STREAMING=true
