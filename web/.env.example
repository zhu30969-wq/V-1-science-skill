# Public information ONLY (spec §63) — no secrets may ever start with
# NEXT_PUBLIC_ unless they are safe to ship to every browser.
#
# NEXT_PUBLIC_GATEWAY_URL points at the secure gateway (local dev: http://127.0.0.1:8787)
# The gateway injects backend auth server-side; the browser never sees keys.

NEXT_PUBLIC_APP_NAME=STOV AI Scientist
NEXT_PUBLIC_GATEWAY_URL=
NEXT_PUBLIC_ASSISTANT_ID=stov_scientist

# GitHub Pages build only (empty for local dev)
NEXT_PUBLIC_BASE_PATH=
